# RamTracker — variables d'environnement (référence : blueprint/06-CONFIG.md §1)
# Copier en `.env` et renseigner. Ne JAMAIS committer `.env`.

# --- chemins & runtime (optionnels, défauts raisonnables) ---
RAMTRACKER_DB_PATH=./ramtracker.db
RAMTRACKER_LOG_LEVEL=INFO
RAMTRACKER_CONFIG_DIR=./configs

# --- eBay (REQUIS) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Code postal pour X-EBAY-C-ENDUSERCTX — sans lui le port renvoyé est faux.
EBAY_ZIP=
# Conformité RGPD/CCPA — suppression de compte eBay (WP10, deploy/worker/).
# Requis avec des clés de production, sinon eBay suspend l'accès à l'API.
# Jeton : 32-80 caractères, [A-Za-z0-9_-]. URL : identique à celle du portail eBay.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=
# File du Worker Cloudflare : RamTracker tire les notifications en attente et
# efface en base. QUEUE_URL = URL de base du worker ; PULL_SECRET = jeton partagé.
ACCOUNT_DELETION_QUEUE_URL=
ACCOUNT_DELETION_PULL_SECRET=

# --- Reddit (optionnel, activé en WP08) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- ntfy (REQUIS) — URL complète du sujet, jeton compris ---
NTFY_URL=

# --- serveur LLM local partagé avec OpenHands (optionnel, activé en WP07) ---
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=

# --- repli LLM distant : voie urgente uniquement (optionnel) ---
ANTHROPIC_API_KEY=
